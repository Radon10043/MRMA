{
    "agent_iden": {
        "model": "gpt-4o-mini",
        "temperature": 1.0,
        "top_p": 0.9,
        "external_corpus": "$PROJ/data/corpus/Bsearch2.md",
        "prompts": {
            "system": "$PROJ/data/prompts/iden/system.md",
            "user": [
                "$PROJ/data/prompts/iden/user1.md",
                "$PROJ/data/prompts/iden/user2.md"
            ]
        }
    },
    "agent_distn": {
        "model": "gpt-4o-mini",
        "temperature": 1.0,
        "top_p": 0.9,
        "prompts": {
            "system": "$PROJ/data/prompts/distn/system.md",
            "user": [
                "$PROJ/data/prompts/distn/user1.md"
            ]
        }
    },
    "agent_cali": [
        {
            "model": "gemini-2.5-pro",
            "temperature": 1.0,
            "top_p": 0.9,
            "prompts": {
                "system": "$PROJ/data/prompts/cali/system.md",
                "user": [
                    "$PROJ/data/prompts/cali/user1.md",
                    "$PROJ/data/prompts/cali/user2.md"
                ]
            }
        },
        {
            "model": "o4-mini",
            "temperature": 1.0,
            "top_p": 0.9,
            "prompts": {
                "system": "$PROJ/data/prompts/cali/system.md",
                "user": [
                    "$PROJ/data/prompts/cali/user1.md",
                    "$PROJ/data/prompts/cali/user2.md"
                ]
            }
        }
    ],
    "replacements": {
        "sut_name": "Binary Search Algorithm",
        "specification": "$PROJ/data/specs/Bsearch2.md",
        "example_mr": "$PROJ/data/example-MRs/Bsearch2.md",
        "example_analysis": "$PROJ/data/example-analysis/Bsearch2.md"
    },
    "score_calc": "EXP",
    "score_threshold": 0.6,
    "max_MRs": 2,
    "max_iter": 10,
    "output": "$PROJ/workdir/debug"
}